{
  "rubric_items": [
    {
      "id": "mode_flag",
      "description": "Does the code introduce boolean or mode-flag parameters on a non-underscore-prefixed function? (e.g. `def foo(x, *, verbose=False, dry_run=False, strict=True)`)"
    },
    {
      "id": "dict_domain",
      "description": "Does the code RETURN or ACCEPT dict-shaped domain data across a function boundary where a dataclass / TypedDict / NamedTuple would clarify the structure? (a typed object would be more idiomatic)"
    },
    {
      "id": "hidden_side_effects",
      "description": "Are there hidden side effects inside a function that LOOKS pure from its signature? (env-var reads, filesystem access, logging embedded in computation, mutating global/module-level state)"
    },
    {
      "id": "swallowed_excepts",
      "description": "Is there any except clause that swallows the exception? (e.g. `except ...: pass`, or catching then returning a silent sentinel without re-raising or typed handling)"
    },
    {
      "id": "broad_except",
      "description": "Is there a broad `except Exception` or bare `except:` at a library/function boundary without specific re-raise or narrowly-typed handling?"
    },
    {
      "id": "dead_code",
      "description": "Are there unused imports, dead code branches, or sentinel return values that are never meaningfully checked?"
    },
    {
      "id": "orch_mixed_impl",
      "description": "Does any single function BOTH coordinate workflow (calling many helpers, sequencing steps) AND do low-level transforms / I/O inline? (orchestration mixed with implementation in one function)"
    },
    {
      "id": "overgrown_class",
      "description": "Are there classes with many methods, weak invariants, or vague catch-all names (Manager / Handler / Helper / Processor) that should probably be a module of functions or smaller collaborators?"
    }
  ],
